[Unit]
Description=Pivloom API
After=network-online.target docker.service pivloom-sandbox-g0.service
Wants=network-online.target

[Service]
Type=simple
User=pivloom-api
Group=pivloom-api
WorkingDirectory=/opt/pivloom/api-current/apps/api
Environment=NODE_ENV=production
Environment=HOME=/var/lib/pivloom-api
EnvironmentFile=/etc/pivloom/api.env
ExecStart=/usr/local/bin/node dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pivloom-api /opt/pivloom/published

[Install]
WantedBy=multi-user.target
