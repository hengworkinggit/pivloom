# Internal Supabase gateway; credentials are never included in this file.
http://:54321 {
    bind 127.0.0.1
    handle_path /auth/v1/* {
        reverse_proxy 127.0.0.1:54323
    }
    handle_path /rest/v1/* {
        reverse_proxy 127.0.0.1:54324
    }
    handle_path /storage/v1/* {
        reverse_proxy 127.0.0.1:54325
    }
    respond 404
}
